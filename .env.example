# Copy to .env (cp .env.example .env). Everything here is optional; defaults work for the local demo.
INTEGRX_ADMIN_KEY=change-me-admin-key
INTEGRX_DOWNSTREAM_TIMEOUT=10
INTEGRX_MAX_RETRIES=2
INTEGRX_RETRY_BACKOFF=2
INTEGRX_ARCHIVE=local:/app/data/archive
INTEGRX_PARTNERS_FILE=/app/deploy/partners.json
INTEGRX_AS2_KEY=/app/deploy/certs/integrx_key.pem
INTEGRX_AS2_KEY_PASS=integrx-demo

# Jira Cloud (free plan). Leave empty to write tickets to data/tickets/ instead.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=SUP
# Base URL of your Confluence runbook pages, used in ticket links (optional)
CONFLUENCE_RUNBOOK_BASE=

# Gemini API free tier. Leave empty to use rule-based triage drafts.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
